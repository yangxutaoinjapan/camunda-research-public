<bpmn:sequenceFlow id="work_in_a" sourceRef="message_start_a" targetRef="call_a"/>
<bpmn:sequenceFlow id="work_out_a" sourceRef="call_a" targetRef="work_end_a"/>
</bpmn:subProcess></bpmn:subProcess>
