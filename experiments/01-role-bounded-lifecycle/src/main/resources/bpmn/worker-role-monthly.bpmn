<bpmn:sequenceFlow id="race_close_a" sourceRef="race_a" targetRef="close_a"/>
<bpmn:sequenceFlow id="close_end_a" sourceRef="close_a" targetRef="scope_end_a"/>
<bpmn:subProcess id="events_a" name="Pushed work.a (non-interrupting)" triggeredByEvent="true">
