<bpmn:process id="worker-role-monthly" name="Worker role: scheduled window plus drain" isExecutable="true">
<bpmn:laneSet id="lanes">
<bpmn:lane id="lane_a" name="Lane a"><bpmn:flowNodeRef>branch_a</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="lane_b" name="Lane b"><bpmn:flowNodeRef>branch_b</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="lane_c" name="Lane c"><bpmn:flowNodeRef>branch_c</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="role_start" name="role.open"><bpmn:messageEventDefinition id="open_definition" messageRef="role_open"/></bpmn:startEvent>
<bpmn:parallelGateway id="fork" name="Open lanes"/>
<bpmn:parallelGateway id="join" name="Lanes drained"/>
<bpmn:endEvent id="role_end" name="Role completed"/>
<bpmn:sequenceFlow id="start_fork" sourceRef="role_start" targetRef="fork"/>
<bpmn:subProcess id="branch_a" name="a: wait until deadline and drain">
<bpmn:startEvent id="scope_start_a"/><bpmn:intermediateCatchEvent id="deadline_a" name="deadline"><bpmn:timerEventDefinition id="deadline_definition_a"><bpmn:timeDate>= deadline</bpmn:timeDate></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent><bpmn:endEvent id="scope_end_a"/>
<bpmn:sequenceFlow id="wait_in_a" sourceRef="scope_start_a" targetRef="race_a"/>
<bpmn:sequenceFlow id="wait_out_a" sourceRef="deadline_a" targetRef="scope_end_a"/>
<bpmn:eventBasedGateway id="race_a"><bpmn:incoming>wait_in_a</bpmn:incoming><bpmn:outgoing>race_timer_a</bpmn:outgoing><bpmn:outgoing>race_close_a</bpmn:outgoing></bpmn:eventBasedGateway>
<bpmn:intermediateCatchEvent id="close_a" name="role.close"><bpmn:messageEventDefinition id="close_definition_a" messageRef="role_close"/></bpmn:intermediateCatchEvent>
