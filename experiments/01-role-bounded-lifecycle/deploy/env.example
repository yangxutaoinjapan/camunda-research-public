# Remote engine REST base, without /v2: https://ENGINE_HOST/orchestration
CAMUNDA_REST_ADDRESS=
# Service credential for a gateway in front of the engine host. Set both or remove both.
GATEWAY_CLIENT_ID=
GATEWAY_CLIENT_SECRET=
# Standard client auth names. Credentials come from the operator's secret store;
# never commit populated values. Select the auth mode needed by your engine.
CAMUNDA_CLIENT_ID=
CAMUNDA_CLIENT_SECRET=
CAMUNDA_AUTHORIZATION_SERVER_URL=
CAMUNDA_TOKEN_AUDIENCE=
CAMUNDA_BASIC_AUTH_USERNAME=
CAMUNDA_BASIC_AUTH_PASSWORD=

LAB_HTTP_BIND=127.0.0.1
LAB_HTTP_PORT=8088
# Public URL prefix; empty serves at /. The proxy must preserve this prefix.
LAB_BASE_PATH=/lifecycle
# Set a strong shared secret for direct API callers or proxy-injected headers.
# Remove this line if intentionally using loopback without an API secret.
LAB_HTTP_TOKEN=

# systemd supplies STATE_DIRECTORY=/var/lib/lifecycle-lab via StateDirectory.
# Outside systemd: default /tmp; optionally set STATE_DIRECTORY to a writable directory.
# STATE_DIRECTORY=/path/to/lifecycle-state
